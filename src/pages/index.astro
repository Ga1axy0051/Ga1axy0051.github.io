---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { news } from '../data/news';
import { profile } from '../data/profile';
import { selectedProject } from '../data/projects';
import { publications } from '../data/publications';
import { background } from '../data/research';

const pageTitle = 'Xiangyu (Xavier) Wang | Robot Learning & Embodied Intelligence';
const pageDescription = 'Xiangyu (Xavier) Wang is an undergraduate researcher at UESTC working on robot learning, embodied intelligence, graph learning, and real-world robot interaction.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <header class="site-header">
    <nav class="nav-shell" aria-label="Primary navigation">
      <a class="wordmark" href="#top">Xiangyu Wang</a>
      <div class="nav-links">
        <a href="#publications">Publications</a>
        <a href="#background">Background</a>
        <a href="#news">News</a>
        <a href="/cv/Xiangyu_Wang_CV.pdf" target="_blank" rel="noreferrer">CV <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">Robot Learning <span aria-hidden="true">/</span> Embodied Intelligence</p>
        <h1 id="hero-title">{profile.displayName}</h1>
        <p class="hero-title">{profile.title}</p>
        <aside class="current-note" aria-label="Current position">
          <p class="note-label">Current</p>
          <p><strong>{profile.currentPosition.institution}</strong></p>
          <p>{profile.currentPosition.role} <span aria-hidden="true">·</span> {profile.currentPosition.mode}</p>
          <p>Advised by {profile.currentPosition.advisor}, {profile.currentPosition.advisorInstitution}</p>
        </aside>
        <div class="biography">
          {profile.biography.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="primary-links" aria-label="Contact and profile links">
          {profile.links.map((link) => (
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? (link.identity ? 'me noreferrer' : 'noreferrer') : undefined}>
              {link.label}{link.external && <span aria-hidden="true"> ↗</span>}
            </a>
          ))}
        </div>
      </div>
      <figure class="portrait">
        <img src="/images/xiangyu-wang.jpg" alt="Xiangyu Wang" width="1612" height="2148" fetchpriority="high" />
      </figure>
    </section>

    <section class="section-block" id="publications" aria-labelledby="publications-heading">
      <SectionHeading eyebrow="01" title="Publications" id="publications-heading" />
      <div class="publication-list">
        {publications.map((publication, index) => <PublicationEntry publication={publication} number={index + 1} />)}
      </div>
    </section>

    <section class="section-block" id="background" aria-labelledby="background-heading">
      <SectionHeading eyebrow="02" title="Background" id="background-heading" />
      <div class="timeline">
        {background.map((entry) => (
          <article class="timeline-entry">
            <p class="date">{entry.dates}</p>
            <div>
              <h3>{entry.institution}</h3>
              <p class="role-line"><strong>{entry.role}</strong>{entry.meta && <><span aria-hidden="true"> · </span>{entry.meta}</>}</p>
              <p class="entry-description">{entry.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block" id="project" aria-labelledby="project-heading">
      <SectionHeading eyebrow="03" title="Selected Project" id="project-heading" />
      <article class="project-entry">
        <h3>{selectedProject.title}</h3>
        <p class="project-context">{selectedProject.institution} <span aria-hidden="true">·</span> {selectedProject.role} <span aria-hidden="true">·</span> Supervised by {selectedProject.supervisor}</p>
        <p>{selectedProject.summary}</p>
      </article>
    </section>

    <section class="section-block" id="leadership" aria-labelledby="leadership-heading">
      <SectionHeading eyebrow="04" title="Leadership & Interests" id="leadership-heading" />
      <div class="leadership-line">
        <p><strong>{profile.leadership.role}</strong>, {profile.leadership.organization} <span aria-hidden="true">·</span> {profile.leadership.recognition}</p>
        <p><span class="small-label">Beyond research</span> {profile.personalInterests.join(' · ')}</p>
      </div>
    </section>

    <section class="section-block" id="news" aria-labelledby="news-heading">
      <SectionHeading eyebrow="05" title="News" id="news-heading" />
      <div class="news-list">
        {news.map((item) => (
          <article class="news-item">
            <time>{item.date}</time>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer id="contact">
    <div>
      <p class="footer-name">Xiangyu Wang</p>
      <p>Robot Learning · Embodied Intelligence</p>
    </div>
    <div class="footer-links">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <a href="https://github.com/Ga1axy0051" target="_blank" rel="me noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </footer>
</BaseLayout>
